{
  "name": "idle-timeout",
  "version": "2.6.0",
  "description": "The minimal idle state detector.",
  "keywords": [
    "idle",
    "timeout",
    "idle-timeout",
    "idle-detection",
    "inactivity",
    "user-activity",
    "activity-tracker",
    "session-timeout",
    "auto-logout",
    "browser",
    "javascript",
    "typescript"
  ],
  "repository": "jacobmllr95/idle-timeout",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "index": "src/index.ts",
  "main": "./dist/idle-timeout.cjs.js",
  "module": "./dist/idle-timeout.esm.mjs",
  "types": "./dist/idle-timeout.esm.d.mts",
  "unpkg": "./dist/idle-timeout.min.umd.js",
  "sideEffects": [
    "./dist/*.umd.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/idle-timeout.esm.d.mts",
      "import": "./dist/idle-timeout.esm.mjs",
      "require": "./dist/idle-timeout.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "maintainers": [
    {
      "name": "Jacob Müller",
      "email": "jacob.mueller.elz@gmail.com"
    }
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --project tsconfig.check.json",
    "lint": "oxlint --type-aware --tsconfig tsconfig.check.json --deny-warnings --report-unused-disable-directives src tests scripts *.config.ts *.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "check:package": "pnpm build && node scripts/check-package.mjs",
    "format:check": "oxfmt --ignore-path .gitignore --check .",
    "prettify": "oxfmt --ignore-path .gitignore --write .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist",
    "src"
  ]
}

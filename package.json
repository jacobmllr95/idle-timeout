{
  "name": "idle-timeout",
  "version": "2.5.0",
  "description": "The minimal idle state detector.",
  "keywords": [
    "idle",
    "timeout",
    "idle-timeout",
    "idle-detection",
    "inactivity",
    "user-activity",
    "activity-tracker",
    "session-timeout",
    "auto-logout",
    "browser",
    "javascript",
    "typescript"
  ],
  "repository": "jacobmllr95/idle-timeout",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "index": "src/index.ts",
  "main": "./dist/idle-timeout.cjs.js",
  "module": "./dist/idle-timeout.esm.mjs",
  "types": "./dist/idle-timeout.esm.d.mts",
  "unpkg": "./dist/idle-timeout.min.umd.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/idle-timeout.esm.d.mts",
      "import": "./dist/idle-timeout.esm.mjs",
      "require": "./dist/idle-timeout.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "maintainers": [
    {
      "name": "Jacob Müller",
      "email": "jacob.mueller.elz@gmail.com"
    }
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "prettify": "prettier --write '**/*.{md,ts}'",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "src"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
